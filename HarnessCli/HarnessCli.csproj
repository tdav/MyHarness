<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>HarnessCli</RootNamespace>
		<AssemblyName>HarnessCli</AssemblyName>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- Harness providers and samples use experimental APIs. -->
		<NoWarn>$(NoWarn);OPENAI001;MAAI001</NoWarn>
		<!-- SharpConsoleUI drives the console itself; the app must not be a Windows subsystem app. -->
		<InvariantGlobalization>false</InvariantGlobalization>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
	</PropertyGroup>

	<!-- Agent, plugins, tracing, settings and the bundled skills/agents/scripts/plugin
       examples are shared with MyHarness; only the console UI lives here. -->
	<ItemGroup>
		<ProjectReference Include="..\Harness.Core\Harness.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="SharpConsoleUI" Version="2.5.14" />
		<PackageReference Include="Microsoft.Agents.AI" Version="1.15.0" />
		<PackageReference Include="Microsoft.Extensions.AI" Version="10.8.1" />
		<PackageReference Include="Serilog" Version="4.2.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
	</ItemGroup>

	<!-- scripts\ appears when the project folder itself is chosen as the agent's working
       folder (seeded examples land there) — never compile those standalone scripts. -->
	<ItemGroup>
		<Compile Remove="scripts\**\*.cs" />
	</ItemGroup>

	<!-- secret.json holds the Ollama Cloud API key; gitignored, copied to output when present. -->
	<ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\secret.json')">
		<Content Include="secret.json" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
