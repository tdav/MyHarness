<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>MyHarness</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Harness providers and samples use experimental APIs. -->
    <NoWarn>$(NoWarn);OPENAI001;MAAI001</NoWarn>
    <!-- The WebView2 package ships a WPF assembly that unifies WindowsBase to a
         different version; harmless in a WinForms-only app. -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
    <!-- Allows building the Windows-targeted project on non-Windows build agents. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>images\avg.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.15.0" />
    <PackageReference Include="Microsoft.Agents.AI.Abstractions" Version="1.15.0" />
    <PackageReference Include="Microsoft.Agents.AI.Harness" Version="1.15.0" />
    <PackageReference Include="Microsoft.Agents.AI.Hyperlight" Version="1.15.0-preview.260722.1" />
    <PackageReference Include="Microsoft.Agents.AI.Tools.Shell" Version="1.15.0-preview.260722.1" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.8.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="OpenAI" Version="2.12.0" />
    <PackageReference Include="OpenTelemetry" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageReference Include="Hyperlight.HyperlightSandbox.Guest.Python" Version="0.5.0" />
    <PackageReference Include="OllamaSharp" Version="5.4.27" />
  </ItemGroup>

  <!-- Copy skills/ and agents/ to the output directory so runtime lookups against
       AppContext.BaseDirectory resolve (the working folder itself is user-chosen). -->
  <ItemGroup>
    <Content Include="skills\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="agents\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Example dotnet scripts (standalone .NET 10 file-based programs, run via `dotnet run`).
       They must NOT be compiled into the app — each has its own top-level statements.
       AgentHost seeds them into <workingDir>\scripts on first run. -->
  <ItemGroup>
    <Compile Remove="dotnet-scripts\**\*.cs" />
    <Content Include="dotnet-scripts\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- scripts\ appears when the project folder itself is chosen as the agent's working
         folder (seeded examples land there) — never compile those standalone scripts. -->
    <Compile Remove="scripts\**\*.cs" />
  </ItemGroup>

  <!-- secret.json holds the Ollama Cloud API key; gitignored, copied to output when present. -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\secret.json')">
    <Content Include="secret.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="images\avg.ico" />
  </ItemGroup>

</Project>
